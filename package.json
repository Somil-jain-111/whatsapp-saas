{
  "name": "relay-whatsapp-saas",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "gen:entity": "ts-node src/generate-entities.ts && sleep 1 && rm -rf src/default/common/ormconfig.json && rm -rf src/default/common/tsconfig.json",
    "start": "nest start",
    "start:local": "cross-env NODE_ENV=local nest start --watch",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:uat": "cross-env NODE_ENV=uat nest start --watch",
    "start:preprod": "cross-env NODE_ENV=preprod nest start",
    "start:test": "cross-env NODE_ENV=test nest start",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/src/main.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "ESLINT_USE_FLAT_CONFIG=false eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --runInBand test/phase-one-database.spec.ts",
    "prepare": "husky install",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/default/databases/mysql/migration.config.ts src/migrations/mysql/migration",
    "migration:generate:postgres": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/default/databases/mysql/migration.config.ts src/migrations/migration",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/default/databases/mysql/migration.config.ts",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/src/default/databases/mysql/migration.config.js",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/default/databases/mysql/migration.config.ts",
    "migration:show": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d src/default/databases/mysql/migration.config.ts",
    "migration:clean": "rm -rf src/migrations",
    "migration:create": "typeorm-ts-node-commonjs migration:create src/migrations/migration",
    "seed:locations": "ts-node -r tsconfig-paths/register src/default/common/seeds/seed-locations.ts",
    "seed:rbac": "ts-node -r tsconfig-paths/register src/default/common/seeds/seed-rbac.ts",
    "seed:storefront": "ts-node -r tsconfig-paths/register src/default/common/seeds/seed-storefront.ts",
    "seed:catalog-demo": "ts-node -r tsconfig-paths/register src/default/common/seeds/seed-demo-catalog.ts",
    "seed:phase1": "ts-node -r tsconfig-paths/register src/modules/database/seeds/seed-phase-one.ts",
    "bootstrap:phase1-account": "ts-node -r tsconfig-paths/register src/modules/database/seeds/bootstrap-phase-one-account.ts",
    "ui:dev": "npm --prefix frontend run dev",
    "ui:build": "npm --prefix frontend run build",
    "ui:lint": "npm --prefix frontend run lint",
    "ui:test": "npm --prefix frontend run test"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.600.0",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/lib-storage": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/bullmq": "^11.0.1",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.17",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.17",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "argon2": "^0.44.0",
    "axios": "^1.20.0",
    "bullmq": "^5.39.2",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-yet": "^5.1.5",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.8",
    "mysql2": "^3.24.6",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.23",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.46",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "husky": "^8.0.3",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  },
  "jest": {
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/migrations/**",
      "!src/**/*.module.ts",
      "!src/main.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/test/jest.setup.ts"
    ]
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@scarf/scarf@1.4.0": true,
    "argon2@0.44.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "handlebars": "4.7.10",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "multer": "2.4.0",
    "lodash": "4.18.1",
    "body-parser": "1.20.8"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  }
}
