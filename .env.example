NODE_ENV=development
PORT=4002
API_VERSION=1
HOST=localhost
PROTOCOL=http
CORS_ALLOWED_ORIGINS=http://localhost:3000
PAYLOAD_LIMIT=1mb
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Replace every example secret. Never commit real values.
API_KEY=replace-with-local-api-key
API_SECRET=replace-with-at-least-16-characters
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
KYC_ENCRYPTION_SECRET_KEY=replace-with-at-least-32-random-characters

# Customer signup email verification. Production requires HTTPS and real credentials.
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
APP_WEB_URL=http://localhost:5173
MAIL_FROM=
COMMUNICATION_API_URL=
COMMUNICATION_API_TOKEN=

# Development/PostgreSQL (all Phase 1-4 modules and migrations)
DB_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=whatsapp

# Local/MySQL compatibility mode. Phase 1-4 modules are disabled in this mode.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=whatsapp

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_TTL=60

META_INTEGRATION_ENABLED=false
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_CALLBACK_URL=https://api.example.com/webhooks/meta
META_REQUIRED_PERMISSIONS=whatsapp_business_management,whatsapp_business_messaging,business_management
META_WEBHOOK_VERIFY_TOKEN=
# Exactly 32 random bytes encoded as base64. Inject using a secret manager in production.
# Required for PostgreSQL deployments; encrypts Meta, API-signing and webhook secrets.
META_CREDENTIAL_ENCRYPTION_KEY_BASE64=
META_CREDENTIAL_KEY_VERSION=v1
META_REQUEST_TIMEOUT_MS=8000
META_SEND_RATE_PER_SECOND=20
META_WEBHOOK_RETENTION_DAYS=30
META_ONBOARDING_TTL_SECONDS=600

BILLING_ENABLED=false
STRIPE_BILLING_ENABLED=false
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_USD_PRICE_ID=
RAZORPAY_BILLING_ENABLED=false
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_INR_PLAN_ID=
# Monthly billing cycles; 120 = 10 years.
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
BILLING_CHECKOUT_SUCCESS_URL=https://app.example.com/billing/success
BILLING_CHECKOUT_CANCEL_URL=https://app.example.com/billing/cancel
BILLING_PORTAL_RETURN_URL=https://app.example.com/billing

# Production private object storage for contact imports and report exports.
# Development falls back to .private-storage/, which is never served publicly.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_BASE_URL=

# Public API credentials; use a secret manager outside local development.
API_KEY_HASH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_API_ACCESS_TOKEN_SECRET=replace-with-a-different-32-character-random-secret
PUBLIC_API_ACCESS_TOKEN_TTL_SECONDS=300
PUBLIC_API_KEY_RATE_PER_MINUTE=60
PUBLIC_API_ORG_RATE_PER_MINUTE=300
PUBLIC_API_SENDER_RATE_PER_MINUTE=80
PUBLIC_API_DAILY_MESSAGE_LIMIT=10000
# Set all three only when Nest terminates TLS and mTLS directly.
TLS_CERT_PATH=
TLS_KEY_PATH=
MTLS_CA_PATH=
